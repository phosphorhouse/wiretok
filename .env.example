# Wiretok runtime environment variables (all optional; sane defaults apply)

# Dashboard HTTP + SSE bind host & port (keep 127.0.0.1 for local-only mode)
WIRETOK_PORT=19840
WIRETOK_HOST=127.0.0.1

# Override data directory (defaults to ~/.wiretok) or SQLite file path
WIRETOK_DATA_DIR=
WIRETOK_DB_PATH=

# Optional extra OpenCode data directories (OS path-delimiter separated: ';' on Windows, ':' on POSIX)
WIRETOK_OPENCODE_DIRS=

# Diagnostics & optional flags (keep disabled in normal usage)
WIRETOK_DEBUG=
WIRETOK_USE_GEMINI_CLI_EMAIL=

# Set automatically by Antigravity when launched inside Sidecar aux pane
ANTIGRAVITY_SIDECAR_WEB_PORT=

# Optional Linux/Unix XDG directory overrides
XDG_DATA_HOME=
XDG_CONFIG_HOME=
