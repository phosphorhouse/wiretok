{
  "command": "node",
  "args": [
    "--no-warnings",
    "../../../../src/server/server.mjs",
    "--sidecar"
  ],
  "restart_policy": "always",
  "display_name": "Wiretok",
  "description": "Update-proof context, token, cache, per-request cost & SSE forensics tracker",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Wiretok",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Wiretok"
      }
    ]
  }
}
